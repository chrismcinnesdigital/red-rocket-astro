---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogPost from "../components/BlogPost.astro";
const allPosts = Object.values(import.meta.glob("./journal/*.md", { eager: true }));
const pageTitle = "The Red Rocket Journal";
---

<BaseLayout pageTitle={pageTitle}>
  <p>This is where I will post about my journey learning Astro.</p>
  <div class="blog-list-wrap">
    {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} description={post.frontmatter.description} image={post.frontmatter.image.url} altText={post.frontmatter.image.alt} />)}
  </div>
</BaseLayout>
