<div id="main-nav" class="navLinks">
  <a href="/">Home</a>
  <a href="/about/">About</a>
  <a href="/journal/">Journal</a>
  <a href="/tags/">Tags</a>
</div>

<style is:global>
  /* nav styles */
.menu {
  background-color: oklab(20% 0 0 / 0.3);
  border: none;
  color: #fff;
  font-size: 1.1rem;
  font-weight: bold;
  padding: 5px 10px;
}

.navLinks {
  width: 100%;
  display: none;
  margin: 0;
}

.navLinks a {
  display: block;
  text-align: center;
  padding: 5px 0;
  text-decoration: none;
  font-size: 1.1rem;
  font-weight: bold;
  text-transform: uppercase;
  line-height: 1;
  letter-spacing: 0.07ch;
  color: #0d0950;
  background-color: oklab(20% 0 0 / 0);
  transition: background-color 500ms ease-in-out, color 350ms ease-in-out;
}

.navLinks a:hover,
.navLinks a:focus {
  color: white;
  background-color: oklab(20% 0 0 / 0.25);
}

:has(.menu[aria-expanded="true"]) .navLinks {
  display: unset;
}

@media screen and (min-width: 636px) {
  .navLinks {
    display: flex;
    column-gap: 1rem;
    position: static;
    width: auto;
    background: none;
  }
  .navLinks a {
    display: inline-block;
    padding: 6px 10px;
    background: none;
    border-radius: 4px;
  }
  .navLinks a.active {
    color: white;
  }
  .menu {
    display: none;
  }
}
</style>
