---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;

---

<BaseLayout pageTitle={frontmatter.title}>
  {frontmatter.image.url && <img src={frontmatter.image.url} class="img-journal-head" alt={frontmatter.image.alt} />}
  <p>{frontmatter.pubDate.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })}&nbsp;&nbsp;|&nbsp;&nbsp;Written by {frontmatter.author}</p>

  <div class="tags">
    {
      frontmatter.tags.map((tag: string) => (
        <p class="tag">
          <a class="link-stealth" href={`/tags/${tag}`}>
            {tag}
          </a>
        </p>
      ))
    }
  </div>

  <div class="content-wrapper">
    <slot />
  </div>
</BaseLayout>

<style is:global>
  .img-journal-head {
    width: 100%;
    height: 250px;
    object-fit: cover;
  }
  .content-wrapper p,
  .content-wrapper ol,
  .content-wrapper ul {
    max-width: 90ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.2ch;
    line-height: 1;
    padding: 6px 12px;
    margin: 0;
    border-radius: 99px;
    color: white;
    background-color: oklab(62.8% 0.225 0.1258);
    transition: background-color 300ms ease-in-out;
  }
  .tag:hover {
    background-color: oklab(50.527% 0.18096 0.10123);
  }
</style>
